cision-maker should do) and briefly justify it in no more than 50 words. Do not discuss any other recommendation alternative.\" &nbsp;<\/em>","DefaultChoices":false,"DataExportTag":"Q7","QuestionID":"QID54","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Before submitting your final allocation decision, imagine you have the opportunity to consult an...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"Thank you for your participation in our study. Please contact the research group at FEELE LAB if...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for your participation in our study. Please contact the research group at FEELE LAB if you have any questions. Please click the next button to register your work on Prolific .","DefaultChoices":false,"DataExportTag":"Q52","QuestionID":"QID55","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for your participation in our study. Please contact the research group at FEELE LAB if...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":" ","TertiaryAttribute":null,"Payload":{"QuestionText":"&nbsp; &nbsp;&nbsp;","DefaultChoices":false,"DataExportTag":"Q6","QuestionID":"QID6","QuestionType":"DB","Selector":"GRB","SubSelector":"WTXB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":" ","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Lan