letedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":"https:\/\/app.prolific.com\/submissions\/complete?cc=CRKUY61S","EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":null,"PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]}}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"In this study, you will be shown an hypothetical allocation decision. Please read the instruction...","TertiaryAttribute":null,"Payload":{"QuestionText":"In this study, you will be shown an hypothetical allocation decision. Please read the instructions carefully, as if you were making the decision.&nbsp;<br>\n<br>\nWe will then ask you a number of comprehension checks. You will receive <b>\u00a30.50<\/b> for each question you answer correctly at <b>the first attempt<\/b>.<br>\n<br>\nAfter you complete the comprehension checks, we will ask for your opinion on certain features of the decision.<br>\n<br>\nPlease click on the button below to read the instructions for the study.","DefaultChoices":false,"DataExportTag":"Q2","QuestionID":"QID1","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In this study, you will be shown an hypothetical allocation decision. Please read the instruction...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"Reassessment We sent the following question to an AI agent (e.g., Chat-GPT, Claude, Gemini), aski...","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:19px;\"><strong>Reassessment<\/strong><\/span><br>\n<br>We sent the following question to an AI agent (e.g., Chat-GPT, Claude, Gemini), asking what it would do if it were in your position. You will shortly see the response by the AI agent to the question. You can ask 2 additional questions of your own. After it responds, if you wish, you can reassess your decision on how much to transfer to the person in room B.<br>","DefaultChoices":false,"DataExportTag":"Q10","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Reassessment We sent the following question to an AI agent (e.g., Chat-GPT, Claude, Gemini), aski...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID10"}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"The person in room B you will be matched with is aware that: - The question below has been asked...","TertiaryAttribute":null,"Payload":{"QuestionText":"The person in room B you will be matched with is aware that:<br \/>\n- The question below has been asked to the AI Agent, but they are not aware of the answer it will give you.<br \/>\n- The person in room B you will be matched knows that you may ask 2 more questions to the AI Agent, but they will not know whether you asked them or not, nor what those questions are, nor the answers given by the AI Agent.<br \/>\n- You will be able to revise your decision after interacting with the AI Agent.","DefaultChoices":false,"DataExportTag":"Q11","QuestionType":"DB","Selector":"GRB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The person in room B you will be matched with is aware that: - The question below has been asked...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID11","SubSelector":"WTXB","Graphics":"IM_LvGe0PZ6VPyRIK1","GraphicsDescription":"Screenshot 2026 04 08 at 16.32.19"}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"We prompted the AI Agent with this question many times and it gave a number of different answers....","TertiaryAttribute":null,"Payload":{"QuestionText":"We prompted the AI Agent with this question many times and it gave a number of different answers.<br \/>\n<br \/>\nWe selected three responses where the AI agent suggested the following recommendation: &quot;<strong>The decision-maker should give &pound;3 to the recipient<\/strong>&quot;.<br \/>\n<br \/>\nIn its response, the AI agent also provided three different evaluative <em>standards <\/em>and three different <em>justifications<\/em> supporting this recommendation. We would like to ask you to rate each response on a set of attributes.<br \/>\n&nbsp;<br \/>\nPlease click on the button below to read and rate each response.","DefaultChoices":false,"DataExportTag":"Q8","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"We prompted the AI Agent with this question many times and it gave a number of different answers....","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID13"}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"What is the least a participant in room A can send to a participant in room B?\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"What is the least a participant in room A can <b>send<\/b> to a participant in room B?&nbsp;","DefaultChoices":false,"DataExportTag":"Q14","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is the least a participant in room A can send to a participant in room B?\u00a0","Choices":{"1":{"Display":"\u00a34"},"2":{"Display":"\u00a310"},"3":{"Display":"\u00a313"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID14"}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"AI Response: \"Evaluative Standard: Equality Recommendation: The decision-maker should give \u00a33 to...","TertiaryAttribute":null,"Payload":{"QuestionText":"AI Response:<br>\n<br>\n\"Evaluative Standard: Equality<br>\nRecommendation: The decision-maker should give \u00a33 to the recipient.<br>\nJustification: By giving \u00a33 to the recipient, both the decision-maker and the recipient will have \u00a37 each. This upholds the principle of equality by ensuring both parties have equal amounts of money.\"","DefaultChoices":false,"DataExportTag":"Q15","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"AI Response: \"Evaluative Standard: Equality Recommendation: The decision-maker should give \u00a33 to...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID15"}},{"SurveyID":"SV_8kK7mFtZv8hrwI6","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Please evaluate the AI Agent's response on the following criteria:","TertiaryAttribute":null,"Payload":{"QuestionText":"Please evaluate the AI Agent's response on the following criteria:","DefaultChoices":false,"DataExportTag":"Q16","QuestionID":"QID16","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":f